---
import { catName, u, logo } from '../lib/site.js';
const { t, hidden = false } = Astro.props;
---
<a class={`card tool${hidden ? ' more' : ''}`} href={u(`/tools/${t.slug}/`)} data-name={t.name.toLowerCase()} data-cats={t.categories.join(' ')} data-text={(t.description + ' ' + t.bestFor).toLowerCase()}>
<div class="th"><img class="logo" src={logo(t)} alt="" width="40" height="40" loading="lazy" decoding="async" /><div><h3>{t.name}</h3><span class="cat">{catName(t.categories[0])}</span></div>{t.affiliate?.found && <span class="partner" title="Runs a partner program; see disclosure">Partner</span>}</div>
<p class="desc">{t.description}</p>
<div class="price"><span>{t.pricing === 'Contact for pricing' ? 'Contact for pricing' : t.pricing}</span></div></a>
