<div class="hero"><h1>Best AI for…</h1></div>
<div class="grid">{categories.map((c)=><a class="card" href={u(`/best/${c.slug}/`)}><h3>Best AI for {c.task}</h3><p>{c.blurb}</p></a>)}</div>
</Base>
