---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools, categories, SITE, u, CHECKED } from '../lib/site.js';
const schema = { '@context':'https://schema.org','@type':'WebSite',name:SITE.name,url:SITE.url,description:SITE.tagline,
 potentialAction:{'@type':'SearchAction',target:SITE.url+'/?q={search_term_string}','query-input':'required name=search_term_string'} };
const withPrice = tools.filter(t=>t.pricing!=='Contact for pricing').length;
const SHOW = 24;
---
<Base title={`${SITE.name}: AI Tools for Recruiters, Compared`} description={`Compare ${tools.length}+ AI recruiting tools for sourcing, screening, scheduling, ATS/CRM, outreach and more. Real pricing, features and who each tool is best for.`} schema={schema}>
<div class="hero"><h1>The AI recruiting tools directory</h1>
<p>Compare {tools.length} AI tools for sourcing, screening, interview scheduling, ATS/CRM, outreach and assessments. Every listing is checked against the vendor's own site.</p>
<div class="search"><input id="q" type="search" placeholder="Search 160 tools: “AI sourcing”, “video interview”, “agency ATS”…" aria-label="Search tools" /></div>
<div class="chips" id="chips"><button class="chip on" data-c="">All</button>{categories.map((c)=><button class="chip" data-c={c.slug}>{c.name}</button>)}</div>
<div class="stats"><span><b>{tools.length}</b> tools</span><span><b>{withPrice}</b> with public pricing</span><span><b>{categories.length}</b> categories</span><span>Last checked <b>{CHECKED}</b></span></div></div>
<p class="muted" id="count" style="margin-top:28px"></p>
<div class="grid" id="tools">{tools.map((t,i) => <ToolCard t={t} hidden={i>=SHOW} />)}</div>
<button class="btn showmore" id="more">Show all {tools.length} tools</button>
<div class="trust"><div><b>Checked at the source</b>Pricing and features come from each vendor's own site. No price shown? We say “Contact for pricing” rather than guess.</div><div><b>Independent</b>Order is editorial: category fit and how complete our verified info is. Partner programs never affect ranking; they're just labelled “Partner”.</div><div><b>Built for recruiters</b>Organised by the job you're doing: sourcing, screening, scheduling, outreach and more.</div></div>
<section id="categories"><h2>Browse by category</h2><div class="grid">{categories.map((c) => <a class="card" href={u(`/category/${c.slug}/`)}><h3>{c.name}</h3><p>{c.blurb}</p><p>{tools.filter(t=>t.categories.includes(c.slug)).length} tools →</p></a>)}</div></section>
<script is:inline>
const q=document.getElementById('q'),cards=[...document.querySelectorAll('.tool')],count=document.getElementById('count'),more=document.getElementById('more'),chips=[...document.querySelectorAll('.chip')];let cat='',all=false;
const p=new URLSearchParams(location.search);if(p.get('q'))q.value=p.get('q');
function f(){const s=q.value.toLowerCase().trim();const filtering=s||cat;let n=0;cards.forEach(el=>{const ok=(!s||el.dataset.name.includes(s)||el.dataset.text.includes(s)||el.dataset.cats.includes(s))&&(!cat||el.dataset.cats.split(' ').includes(cat));const vis=ok&&(filtering||all||!el.classList.contains('more'));el.style.display=vis?'flex':'none';if(ok)n++});count.textContent=filtering?n+' matching tools':'Showing '+(all?cards.length:cards.filter(c=>!c.classList.contains('more')).length)+' of '+cards.length+' tools';more.style.display=(filtering||all)?'none':'block'}
q.oninput=f;more.onclick=()=>{all=true;f()};chips.forEach(c=>c.onclick=()=>{chips.forEach(x=>x.classList.remove('on'));c.classList.add('on');cat=c.dataset.c;f()});f();
</script>
</Base>
