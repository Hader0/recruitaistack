---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools, categories, SITE, u } from '../lib/site.js';
const schema = { '@context':'https://schema.org','@type':'WebSite',name:SITE.name,url:SITE.url,description:SITE.tagline,
 potentialAction:{'@type':'SearchAction',target:SITE.url+'/?q={search_term_string}','query-input':'required name=search_term_string'} };
---
<Base title={`${SITE.name}: AI Tools for Recruiters, Compared`} description={`Compare ${tools.length}+ AI recruiting tools for sourcing, screening, scheduling, ATS/CRM, outreach and more. Real pricing, features and who each tool is best for.`} schema={schema}>
<div class="hero"><h1>Find the right AI tool for recruiting</h1><p>{tools.length} AI tools for sourcing, screening, scheduling, ATS/CRM, outreach and more, with pricing checked against vendor sites.</p></div>
<div class="filters"><input id="q" type="search" placeholder="Search tools, e.g. sourcing, video, agency…" aria-label="Search tools" />
<select id="cat" aria-label="Filter by category"><option value="">All categories</option>{categories.map((c) => <option value={c.slug}>{c.name}</option>)}</select></div>
<p class="muted" id="count"></p>
<div class="grid" id="tools">{tools.map((t) => <ToolCard t={t} />)}</div>
<section id="categories"><h2>Browse by category</h2><div class="grid">{categories.map((c) => <a class="card" href={u(`/category/${c.slug}/`)}><h3>{c.name}</h3><p>{c.blurb}</p><p>{tools.filter(t=>t.categories.includes(c.slug)).length} tools →</p></a>)}</div></section>
<script is:inline>
const q=document.getElementById('q'),cat=document.getElementById('cat'),cards=[...document.querySelectorAll('.tool')],count=document.getElementById('count');
const p=new URLSearchParams(location.search);if(p.get('q'))q.value=p.get('q');if(p.get('cat'))cat.value=p.get('cat');
function f(){const s=q.value.toLowerCase().trim(),c=cat.value;let n=0;cards.forEach(el=>{const ok=(!s||el.dataset.name.includes(s)||el.dataset.text.includes(s)||el.dataset.cats.includes(s))&&(!c||el.dataset.cats.split(' ').includes(c));el.style.display=ok?'':'none';if(ok)n++});count.textContent=n+' tools'}
q.oninput=f;cat.onchange=f;f();
</script>
</Base>
